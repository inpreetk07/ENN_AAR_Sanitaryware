<!-- HERO SECTION -->
<section class="hero-section" id="home">

    <div class="hero-overlay"></div>

    <div class="container hero-content">
        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="eyebrow">
                    ELEGANCE MEETS QUALITY
                </span>

                <h1>
                    Transform Your
                    Bathroom Into
                    <span>Luxury.</span>
                </h1>

                <p>
                    Discover premium sanitaryware, modern bathroom fittings
                    and elegant designs that redefine your space.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">

                    <a href="#products" class="btn btn-gold">
                        Explore Collection
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <a href="#about" class="btn btn-outline-light rounded-pill px-4 py-3">
                        Discover Our Store
                    </a>

                </div>

                <div class="hero-stats mt-5">
                    <div>
                        <h3>Premium</h3>
                        <span>Product Quality</span>
                    </div>
                    <div>
                        <h3>Trusted</h3>
                        <span>Brands</span>
                    </div>
                    <div>
                        <h3>Elegant</h3>
                        <span>Designs</span>
                    </div>
                </div>

            </div>

        </div>
    </div>

</section>


<!-- PRODUCTS SECTION -->
<section class="section-padding products-section" id="products">

    <div class="container">

        <div class="section-heading">
            <span class="eyebrow-dark">OUR COLLECTION</span>
            <h2>Featured Products</h2>
            <p>Explore quality products designed for modern living.</p>
        </div>

        @{
            var showroomImages = new[]
            {
        new { Name = "Toilet Collection 1", Image = "toilet-1.jpeg" },
        new { Name = "Toilet Collection 2", Image = "toilet-2.jpeg" },
        new { Name = "Toilet Collection 3", Image = "toilet-3.jpeg" },
        new { Name = "Black Vanity", Image = "vanity-black.jpeg" },
        new { Name = "Brown Vanity", Image = "vanity-brown.jpeg" },
        new { Name = "Grey Vanity", Image = "vanity-grey.jpeg" },
        new { Name = "Marble Vanity", Image = "vanity-marble.jpeg" },
        new { Name = "White Vanity", Image = "vanity-white.jpeg" },
        new { Name = "Pedestal Wash Basin", Image = "basin-pedestal.jpeg" }
    };
        }
        <div class="row align-items-center mb-4">

            <div class="col-lg-6 mb-3 mb-lg-0">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="productSearch"
                           placeholder="Search products, brands or models...">
                </div>
            </div>

            <div class="col-lg-6">
                <div class="category-filters" id="categoryFilters">
                    <button class="filter-btn active" data-category="all">All</button>
                    <button class="filter-btn" data-category="toilets">Toilets</button>
                    <button class="filter-btn" data-category="wash basins">Wash Basins</button>
                    <button class="filter-btn" data-category="vanity units">Vanity Units</button>
                    <button class="filter-btn" data-category="faucets">Faucets</button>
                    <button class="filter-btn" data-category="showers">Showers</button>
                    <button class="filter-btn" data-category="bathroom accessories">Accessories</button>
                    <button class="filter-btn" data-category="other">Other</button>
                </div>
            </div>

        </div>
        <div class="row g-4 mb-5">
            @foreach (var item in showroomImages)
            {
                <div class="col-6 col-md-4 product-item showroom-item"
                     data-category="@(item.Name.Contains("Toilet") ? "toilets" : item.Name.Contains("Vanity") ? "vanity units" : "wash basins")">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@Url.Content("~/images/" + item.Image)"
                             class="card-img-top"
                             alt="@item.Name"
                             style="height:250px; object-fit:cover;" />

                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>

                            <a href="@("https://wa.me/919815172233?text=" + Uri.EscapeDataString("Hello ENN AAR, I am interested in " + item.Name + "."))"
                               target="_blank"
                               class="btn btn-dark rounded-pill w-100">
                                <i class="bi bi-whatsapp me-2"></i>
                                Enquire Now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="row g-4" id="productGrid">

            @if (Model != null && Model.Count > 0)
            {
                @foreach (var product in Model)
                {
                    <div class="col-6 col-md-4 product-item"
                         data-category="@product.Category.ToLower()">

                        <div class="card h-100 shadow-sm border-0">

                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@product.ImagePath"
                                     class="card-img-top"
                                     alt="@product.Name"
                                     style="height:250px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="height:250px;">
                                    <i class="bi bi-image fs-1 text-secondary"></i>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">

                                <span class="text-uppercase text-secondary small">
                                    @product.Category
                                </span>

                                <h5 class="card-title mt-2">
                                    @product.Name
                                </h5>

                                <p class="card-text text-muted">
                                    @product.Description
                                </p>

                                <h5 class="fw-bold mb-3">
                                    ₹@product.Price.ToString("N0")
                                </h5>

                                <a href="@("https://wa.me/919815172233?text=" + Uri.EscapeDataString("Hello ENN AAR, I am interested in " + product.Name + "."))"
                                   target="_blank"
                                   class="btn btn-dark rounded-pill w-100 mt-auto">
                                    <i class="bi bi-whatsapp me-2"></i>
                                    Enquire Now
                                </a>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <h4>No products available yet</h4>
                    <p class="text-muted">
                        Please check back soon for our latest collection.
                    </p>
                </div>
            }

        </div>

        
        <div id="noProducts" class="text-center py-5 d-none">
            <i class="bi bi-search fs-1"></i>
            <h4 class="mt-3">No products found</h4>
            <p>Try searching with another name or category.</p>
        </div>

    </div>

</section>


<!-- BRANDS -->

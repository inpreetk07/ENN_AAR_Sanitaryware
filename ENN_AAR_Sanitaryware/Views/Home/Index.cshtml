                </a>

            </div>

        </div>

    </div>

</section>


<!-- CONTACT -->
<section class="contact-section section-padding" id="contact">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="eyebrow">GET IN TOUCH</span>

                <h2>Let's Create Something Beautiful.</h2>

                <p>
                    Looking for the perfect sanitaryware for your home?
                    Contact our store for product information and enquiries.
                </p>

                <div class="contact-item">
                    <i class="bi bi-telephone"></i>
                    <div>
                        <h6>Phone</h6>
                        <p>+91 9815172233</p>
                    </div>
                </div>

                <div class="contact-item">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <h6>Store Address</h6>
                        <p><p>
    ENN AAR Sanitaryware,
    Ganeshpur Bharta,
    Hoshiarpur, Punjab - 146106
</p>

<a href="https://maps.app.goo.gl/xYxqSNq1CbGYp9oh7?g_st=aw"
   target="_blank">
    Get Directions
    <i class="bi bi-arrow-up-right"></i>
</a>
     </div>
     </div>

    <div class="contact-item">
        <i class="bi bi-clock"></i>
        <div>
        <h6>Business Hours</h6>
        <p>Monday - Saturday: 9:00 AM - 6:30 PM</p>
        <p>Sunday: 9:00 AM - 2:00 PM</p>
        <p>Open all 7 days</p>
        </div>
        </div>

        <a href="https://wa.me/9815172233"
        target="_blank" class="btn btn-gold mt-3">
                    <i class="bi bi-whatsapp me-2"></i>
                    Chat On WhatsApp
                </a>

            </div>

            
<div class="col-lg-6">
    <div class="contact-card">
        <i class="bi bi-chat-square-text"></i>
        <h3>Send an Enquiry</h3>
        <p>Fill in your details and our team will contact you.</p>

        @if (TempData["EnquirySuccess"] != null)
{
    <div class="modal fade" id="enquirySuccessModal"
         tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">

                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success"
                       style="font-size: 55px;"></i>
                </div>

                <h4>Enquiry Submitted!</h4>

                <p class="text-muted">
                    Thank you! Your enquiry has been received successfully.
                </p>

                <button type="button"
                        class="btn btn-dark rounded-pill px-4"
                        data-bs-dismiss="modal">
                    Okay
                </button>

            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modalElement =
                document.getElementById("enquirySuccessModal");

            var successModal =
                new bootstrap.Modal(modalElement);

            successModal.show();
        });
    </script>
}

        @if (TempData["EnquiryError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["EnquiryError"]
            </div>
        }

        <form asp-controller="Home"
              asp-action="SubmitEnquiry"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">
                <label class="form-label">Your Name</label>
                <input type="text" name="CustomerName"
                       class="form-control"
                       maxlength="100" required
                       placeholder="Enter your name" />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">Mobile Number</label>
                <input type="tel" name="PhoneNumber"
                       class="form-control"
                       maxlength="20" required
                       placeholder="Enter your mobile number" />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">Interested Product</label>
                <select name="ProductName" class="form-select" required>
                    <option value="">Select a product</option>
                    @foreach (var product in Model)
                    {
                        <option value="@product.Name">@product.Name</option>
                    }
                    <option value="General Enquiry">General Enquiry</option>
                </select>
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">Message</label>
                <textarea name="Message" class="form-control"
                          rows="3" maxlength="1000"
                          placeholder="Write your enquiry"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-dark w-100 rounded-pill py-3">
                Submit Enquiry
            </button>
        </form>
    </div>
</div>


        </div>

    </div>

</section>



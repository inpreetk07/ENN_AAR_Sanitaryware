    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model IEnumerable<ENN_AAR_Sanitaryware.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Categories - ENN AAR</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f2eb;
            color: #252b35;
            font-family: Arial, sans-serif;
        }

        .container-box {
            max-width: 1000px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 14px;
        }

        .btn-gold {
            background: #b99a62;
            color: white;
        }

        .btn-gold:hover {
            background: #9f824d;
            color: white;
        }
    </style>
</head>

<body>
    <div class="container-box">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Manage Categories</h2>
                <p class="text-secondary mb-0">ENN AAR Sanitaryware</p>
            </div>

            <a asp-action="Create" class="btn btn-gold">
                + Add Category
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No categories added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>@category.Description</td>
                                <td>@category.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this category?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary mt-3">
            Back to Dashboard
        </a>

    </div>
</body>
</html>

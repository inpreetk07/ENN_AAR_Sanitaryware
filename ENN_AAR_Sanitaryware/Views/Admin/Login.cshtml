@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ENN AAR - Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>
<body style="background:#f5f2eb; min-height:100vh; display:grid; place-items:center;">

    <div class="card shadow p-4" style="width:100%; max-width:400px; border:0;">
        <h3 class="text-center mb-2">ENN AAR</h3>
        <p class="text-center text-muted">Administrator Login</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Admin" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input name="username" class="form-control"
                       placeholder="Enter username" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input name="password" type="password"
                       class="form-control"
                       placeholder="Enter password" required />
            </div>

            <button class="btn btn-dark w-100" type="submit">
                Login to Dashboard
            </button>
        </form>
        <div class="text-center mt-3">
            <a href="/" class="btn btn-outline-dark rounded-pill w-100">
                <i class="bi bi-house-door me-2"></i>
                Back to Home
            </a>
        </div>
    </div>

</body>
</html>

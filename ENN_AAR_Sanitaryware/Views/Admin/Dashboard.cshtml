@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ENN AAR | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                background: #f5f3ee;
                font-family: Arial, sans-serif;
            }

            .sidebar {
                background: #263449;
                min-height: 100vh;
                color: white;
                padding: 28px 20px;
            }

                .sidebar a {
                    display: block;
                    color: #ddd;
                    text-decoration: none;
                    padding: 13px;
                    border-radius: 8px;
                    margin: 8px 0;
                }

                    .sidebar a:hover {
                        background: #3c506d;
                        color: white;
                    }

            .main-content {
                padding: 35px;
            }

            .stat-card {
                background: white;
                border: 0;
                border-radius: 14px;
                padding: 25px;
                box-shadow: 0 4px 15px rgba(0,0,0,.04);
            }

            .stat-icon {
                font-size: 27px;
                color: #b59661;
            }

            .welcome {
                color: #263449;
            }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">

            <aside class="col-md-3 col-lg-2 sidebar">
                <h4 class="mb-4">ENN AAR</h4>
                <small class="text-secondary">ADMIN PANEL</small>

                <a href="/Admin/Dashboard">
                    <i class="bi bi-grid"></i> Dashboard
                </a>

                <a href="/Product/Index">
                    <i class="bi bi-box-seam"></i> Manage Products
                </a>
                <a href="/Product/Create">
                    <i class="bi bi-plus-circle"></i> Add Product
                </a>
                <a asp-controller="Categories"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-tags"></i>
                    Categories
                </a>
                <a asp-controller="Enquiries"
   asp-action="Index"
   class="sidebar-link">
    <i class="bi bi-chat-dots"></i>
    Enquiries
</a>

                <hr />

                <form asp-controller="Admin" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-light w-100" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </aside>

            <main class="col-md-9 col-lg-10 main-content">

                <h2 class="welcome">Welcome, Administrator!</h2>
                <p class="text-muted">Manage your ENN AAR Sanitaryware store.</p>

                <div class="row g-4 mt-2">

                    <div class="col-md-6 col-xl-3">
                        <div class="stat-card">
                            <i class="bi bi-box-seam stat-icon"></i>
                            <h3 class="mt-3">@ViewBag.TotalProducts</h3>
                            <p class="text-muted mb-0">Total Products</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <div class="stat-card">
                            <i class="bi bi-check-circle stat-icon"></i>
                            <h3 class="mt-3">@ViewBag.AvailableProducts</h3>
                            <p class="text-muted mb-0">Available Products</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <div class="stat-card">
                            <i class="bi bi-x-circle stat-icon"></i>
                            <h3 class="mt-3">@ViewBag.UnavailableProducts</h3>
                            <p class="text-muted mb-0">Unavailable Products</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
    <div class="stat-card">
        <i class="bi bi-chat-dots stat-icon"></i>
        <h3 class="mt-3">@ViewBag.TotalEnquiries</h3>
        <p class="text-muted mb-0">Total Enquiries</p>
    </div>
</div>

                </div>

                
                <div class="stat-card mt-4">
                    <h5>Quick Actions</h5>
                    <p class="text-muted">Manage your store from one place.</p>

                    <a asp-controller="Product"
                       asp-action="Create"
                       class="btn btn-dark me-2 mb-2">
                        <i class="bi bi-plus-lg"></i> Add Product
                    </a>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-outline-dark mb-2">
                        <i class="bi bi-box-seam"></i> Manage Products
                    </a>

                    <a asp-controller="Admin"
                       asp-action="ChangePassword"
                       class="btn btn-outline-dark rounded-pill">
                        <i class="bi bi-key me-2"></i>
                        Change Password
                    </a>

                </div>

                
          

                @{
                    var recentProducts = ViewBag.RecentProducts as List<ENN_AAR_Sanitaryware.Models.Product>;
                }

                <div class="stat-card mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="mb-1">Recent Products</h5>
                            <p class="text-muted mb-0 small">Latest products added to your store</p>
                        </div>
                        <a href="/Product/Index" class="btn btn-outline-dark btn-sm">
                            View All
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentProducts != null && recentProducts.Count > 0)
                                {
                                    @foreach (var product in recentProducts)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                                {
                                                    <img src="@product.ImagePath"
                                                         alt="@product.Name"
                                                         style="width:55px;height:55px;object-fit:cover;border-radius:8px;" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No image</span>
                                                }
                                            </td>
                                            <td>@product.Name</td>
                                            <td>@product.Category</td>
                                            <td>₹@product.Price.ToString("N0")</td>
                                            <td>
                                                @if (product.IsAvailable)
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Unavailable</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            No products added yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>


            </main>
        </div>
    </div>
</body>
</html>

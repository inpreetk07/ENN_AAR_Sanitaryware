
@model IEnumerable<ENN_AAR_Sanitaryware.Models.Enquiry>

@{
    ViewData["Title"] = "Customer Enquiries";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Customer Enquiries - ENN AAR</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f2eb;
            color: #252b35;
            font-family: Arial, sans-serif;
        }

        .container-box {
            max-width: 1200px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 14px;
        }

        .badge-pending {
            background: #ffc107;
            color: #252b35;
        }

        .badge-contacted {
            background: #0d6efd;
        }

        .badge-completed {
            background: #198754;
        }
    </style>
</head>

<body>
    <div class="container-box">

        <h2>Customer Enquiries</h2>
        <p class="text-secondary">ENN AAR Sanitaryware</p>

        @if (!Model.Any())
        {
            <div class="alert alert-info mt-4">
                No customer enquiries received yet.
            </div>
        }
        else
        {
            <div class="table-responsive mt-4">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Product</th>
                            <th>Message</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var enquiry in Model)
                        {
                            <tr>
                                <td>@enquiry.CustomerName</td>
                                <td>
                                    <a href="tel:@enquiry.PhoneNumber">
                                        @enquiry.PhoneNumber
                                    </a>
                                </td>
                                <td>@enquiry.ProductName</td>
                                <td>@enquiry.Message</td>
                                <td>@enquiry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (enquiry.Status == "Pending")
                                    {
                                        <span class="badge badge-pending">Pending</span>
                                    }
                                    else if (enquiry.Status == "Contacted")
                                    {
                                        <span class="badge badge-contacted">Contacted</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-completed">Completed</span>
                                    }
                                </td>

                                <td>
                                    <form asp-action="UpdateStatus"
                                          asp-route-id="@enquiry.Id"
                                          method="post"
                                          class="mb-2">

                                        @Html.AntiForgeryToken()

                                        <select name="status"
        class="form-select form-select-sm mb-2">

    <option value="Pending"
            selected="@(enquiry.Status == "Pending")">
        Pending
    </option>

    <option value="Contacted"
            selected="@(enquiry.Status == "Contacted")">
        Contacted
    </option>

    <option value="Completed"
            selected="@(enquiry.Status == "Completed")">
        Completed
    </option>

</select>

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            Update
                                        </button>
                                    </form>

                                    <form asp-action="Delete"
                                          asp-route-id="@enquiry.Id"
                                          method="post"
                                          onsubmit="return confirm('Delete this enquiry?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary mt-3">
            Back to Dashboard
        </a>

    </div>
</body>
</html>

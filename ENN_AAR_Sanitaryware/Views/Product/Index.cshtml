@model IEnumerable<ENN_AAR_Sanitaryware.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Products - ENN AAR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <th>Actions</th>
    <style>
            body {
                background: #f5f2eb;
                color: #252b35;
                font-family: Arial, sans-serif;
            }

            .container-box {
                max-width: 1150px;
                margin: 40px auto;
                background: white;
                padding: 30px;
                border-radius: 14px;
            }

            .btn-gold {
                background: #b99a62;
                color: white;
            }

            .product-image {
                width: 65px;
                height: 65px;
                object-fit: cover;
                border-radius: 8px;
            }
    </style>
</head>
<body>
    <div class="container-box">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Manage Products</h2>
                <p class="text-secondary mb-0">ENN AAR Sanitaryware</p>
            </div>

            <a asp-action="Create" class="btn btn-gold">
                + Add Product
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No products added yet. Click Add Product to get started.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Availability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImagePath))
                                    {
                                        <img src="@product.ImagePath"
                                             class="product-image"
                                             alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <span class="text-secondary">No image</span>
                                    }
                                </td>
                                <td>@product.Name</td>
                                <td>@product.Category</td>
                                <td>₹@product.Price.ToString("N2")</td>
                                <td>
                                    @if (product.IsAvailable)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unavailable</span>
                                    }
                                </td>


                                <td>
                                    <form asp-action="ToggleAvailability"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (product.IsAvailable)
                                        {
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                Mark Unavailable
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success">
                                                Mark Available
                                            </button>
                                        }
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@product.Id"
                                       class="btn btn-sm btn-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@product.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a asp-controller="Admin" asp-action="Dashboard"
           class="btn btn-outline-secondary mt-3">
            Back to Dashboard
        </a>
    </div>
</body>
</html>

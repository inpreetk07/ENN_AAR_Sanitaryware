@using Microsoft.AspNetCore.Mvc.Rendering 
@model ENN_AAR_Sanitaryware.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Product - ENN AAR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body style="background:#f5f2eb;">

    <div class="container mt-5">
        <div class="card shadow-sm mx-auto p-4" style="max-width:700px;">

            <h2 class="mb-4">Edit Product</h2>

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Product Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Category</label>

                    <select asp-for="Category"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Categories, "Name", "Name"))">
                        <option value="">Select Category</option>
                    </select>

                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price (₹)</label>
                    <input asp-for="Price" type="number" step="0.01"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Current Product Image</label>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImagePath"
                                 style="width:180px;height:140px;object-fit:cover;"
                                 alt="@Model.Name" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No image uploaded.</p>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Replace Product Image</label>

                    <input type="file"
                           name="image"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <small class="text-muted">
                        Leave empty to keep the current image. Maximum 5 MB.
                    </small>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label">
                        Product Available
                    </label>
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    Update Product
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100 mt-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</body>
</html>
